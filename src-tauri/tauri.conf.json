{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hanzo IDE",
  "version": "0.1.0",
  "identifier": "ai.hanzo.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true,
      "freezePrototype": false,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "appimage",
      "deb",
      "nsis",
      "msi"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Hanzo AI. All rights reserved.",
    "shortDescription": "AI-native IDE",
    "longDescription": "Hanzo is an AI-native desktop IDE built on Rust and Tauri with the VS Code workbench, a multi-agent coding engine, and codebase-aware memory.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../node-extension-host/dist/*": "node-extension-host/dist/"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://download.hanzo.ai/hanzo-ide/binaries/production/updates.json",
        "https://github.com/hanzoai/ide/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCN0NBN0FEOUYyQzY0QzcKUldUSFpDeWZyYWQ4dTlqMHhtK293c3BSc2RsTGo2eEtyOGpOSE9YRllqSUo5Q0o4V0IzQ0xpTlQK",
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
